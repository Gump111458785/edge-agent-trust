{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member C knowledge document payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "chunks"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "text"],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
